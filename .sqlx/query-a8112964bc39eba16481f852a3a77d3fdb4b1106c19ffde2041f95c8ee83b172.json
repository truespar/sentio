  "query": "SELECT id, tenant_id, domain_id, direction, envelope_from, envelope_to, header_from, header_to, header_cc, header_reply_to, subject, message_id_header, status, tags, metadata, message_size, raw_eml_key, spam_score, spam_action, send_at, dsn_ret, dsn_envid, dsn_notify, dsn_orcpt, created_at, delivered_at, bounced_at, llm_category, llm_summary, llm_classified_at FROM messages WHERE tenant_id = $1 AND created_at >= $2 AND created_at < $3 AND status = $4 ORDER BY created_at DESC LIMIT $5 OFFSET $6",
