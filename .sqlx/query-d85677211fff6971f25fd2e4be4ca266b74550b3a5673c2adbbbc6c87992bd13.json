  "db_name": "PostgreSQL",
  "query": "SELECT id, tenant_id, severity, component, error_type, message, stack_trace, message_id, request_id, metadata, created_at FROM error_events WHERE tenant_id = $1 AND ($2::text IS NULL OR severity = $2) AND ($3::text IS NULL OR component = $3) AND ($4::text IS NULL OR error_type = $4) AND ($5::timestamptz IS NULL OR created_at >= $5) AND ($6::timestamptz IS NULL OR created_at <= $6) ORDER BY created_at DESC LIMIT $7 OFFSET $8",
